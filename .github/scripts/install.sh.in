#!/bin/sh
# Installs nare @NARE_VERSION@ with its terminal UI.
#
#   curl -fsSL https://github.com/ViviDynamics/nare/releases/download/@NARE_VERSION@/install.sh | sh
#
# Bound to one release: the release job wrote this script's tag and its
# wheel's SHA-256 in at build time, so it installs that wheel and nothing
# else, from whichever URL it was fetched. Needs curl and uv
# (https://docs.astral.sh/uv/); uv brings Python 3.12 when the system has none.
# Running it again reinstalls the same release.
#
# Everything runs inside main, called on the last line, so a download cut off
# part way through runs nothing.

main() (
    set -eu

    version='@NARE_VERSION@'
    wheel_sha256='@NARE_WHEEL_SHA256@'
    wheel="nare-$version-py3-none-any.whl"

    fail() {
        printf 'nare installer: %s\n' "$*" >&2
        exit 1
    }

    if [ "$#" -gt 0 ]; then
        case "$1" in
            -h | --help)
                printf '%s\n' \
                    'Usage: sh install.sh' \
                    "Installs nare $version with the tui extra, using uv." \
                    'Needs curl and uv (https://docs.astral.sh/uv/).'
                exit 0
                ;;
            *)
                fail "this script is bound to nare $version and takes no options." \
                    "For another release, run that release's install.sh."
                ;;
        esac
    fi

    # Only for testing the installer against local bytes. The digest above
    # still has to match, so this cannot install anything else.
    release_url=${NARE_RELEASE_URL:-https://github.com/ViviDynamics/nare/releases/download/$version}
    case "$release_url" in
        https://* | file://*) ;;
        *) fail 'NARE_RELEASE_URL must be an https:// or file:// URL.' ;;
    esac

    command -v curl >/dev/null 2>&1 || fail 'curl is required. Install it, then run this again.'
    uv=$(command -v uv 2>/dev/null || true)
    if [ -z "$uv" ] && [ -x "${HOME:-}/.local/bin/uv" ]; then
        uv=$HOME/.local/bin/uv
    fi
    [ -n "$uv" ] || fail 'uv is required. Install it from' \
        'https://docs.astral.sh/uv/getting-started/installation/ and run this again.'
    if command -v sha256sum >/dev/null 2>&1; then
        sha256() { sha256sum "$1"; }
    elif command -v shasum >/dev/null 2>&1; then
        sha256() { shasum -a 256 "$1"; }
    else
        fail 'sha256sum or shasum is required to verify the download.'
    fi

    tmp=$(mktemp -d) || fail 'could not create a temporary directory.'
    trap 'rm -rf "$tmp"' EXIT
    trap 'exit 1' HUP INT TERM

    printf 'Downloading %s\n' "$release_url/$wheel"
    curl --fail --silent --show-error --location \
        --proto '=https,file' --proto-redir '=https' \
        --connect-timeout 15 --retry 3 \
        --output "$tmp/$wheel" "$release_url/$wheel" \
        || fail "could not download $release_url/$wheel"

    digest=$(sha256 "$tmp/$wheel") || fail "could not hash $wheel."
    [ "${digest%% *}" = "$wheel_sha256" ] \
        || fail "$wheel does not match the SHA-256 this installer was released" \
            "with, so nothing was installed."
    printf 'Verified SHA-256 %s\n' "$wheel_sha256"

    # --force replaces an earlier install, of this release or another, so a
    # repeat run ends in the same state as the first. uv tool install takes
    # the default interpreter rather than the wheel's requires-python, so ask
    # for one that fits; uv downloads it when the system has none.
    printf 'Installing nare %s with the terminal UI\n' "$version"
    "$uv" tool install --force --python '>=3.12' \
        "nare[tui] @ file://$tmp/$wheel" </dev/null \
        || fail 'uv could not install nare; its error is above.'

    bin_dir=$("$uv" tool dir --bin) || fail 'uv could not name its tool bin directory.'
    tool_dir=$("$uv" tool dir) || fail 'uv could not name its tool directory.'
    installed=$("$bin_dir/nare" --version </dev/null) \
        || fail "the installed $bin_dir/nare did not run."
    [ "$installed" = "$version" ] \
        || fail "the installed nare reports $installed, expected $version."
    "$tool_dir/nare/bin/python" -c 'import nare.tui.app' </dev/null \
        || fail "nare $version installed, but its TUI does not import."

    printf '\nnare %s is installed, with the terminal UI.\n' "$version"
    printf '  Start the terminal UI:  nare tui\n'
    printf '  Run without the UI:     nare run --yes "..."\n'
    printf 'Set ANTHROPIC_API_KEY first, or see the README for other providers.\n'
    case ":${PATH:-}:" in
        *":$bin_dir:"*) ;;
        *)
            printf '\n%s is not on your PATH yet. Run: uv tool update-shell\n' "$bin_dir"
            printf 'then open a new terminal, or call %s/nare directly.\n' "$bin_dir"
            ;;
    esac
)

main "$@"
