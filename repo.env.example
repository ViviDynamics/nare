# The configuration the scripts in .agents/skills/*/scripts read, committed so every
# clone and worktree has it. An optional, gitignored repo.env next to it may set only
# the per-person keys, VIVI_ASSIGNEE and VIVI_GH_TOKEN_FILE; anything else there is
# ignored (check-wiring reports it).
VIVI_REPO=ViviDynamics/nare
VIVI_DEFAULT_BRANCH=main
VIVI_MERGE_FLAGS="--squash --delete-branch"

# Workflow FILE name that gates PRs (e.g. ci.yml). Empty: all runs.
VIVI_CI_WORKFLOW=ci.yml
# Workflow FILES that run on pull requests but are advisory here: the gate is ci.yml
# alone, as before 2026.11.0. external-contributions.yml is a policy backstop for outside
# pull requests, never a check on the change.
VIVI_CI_IGNORE_WORKFLOWS="external-contributions.yml"

# Optional configuration for ship-issue and review workflows.
VIVI_REVIEW_TOOL=self   # self | independent | harness | copilot
# Per person: set your own GitHub login in your local repo.env, never here.
# Empty: ship-issue claims issues as the token's own login.
# VIVI_ASSIGNEE=
# VIVI_HOUSE_RULES_FILE=

# Test commands, flake signatures, and token file.
VIVI_TEST_COMMANDS_FILE=.agents/test-commands.md
# VIVI_FLAKE_SIGNATURES_FILE=.agents/flake-signatures.txt

# A file holding a GitHub token with access to this repo, set per person in repo.env.
# When unset, the scripts use GH_TOKEN or GITHUB_TOKEN from the environment instead.
# VIVI_GH_TOKEN_FILE=$HOME/.config/nare/gh-token

# merge-verified proves a green run tested the current main with the default
# VIVI_MERGE_FRESHNESS=record: ci.yml's "Record the tested merge <sha>" step.
# cleanup (after a merge) uses the defaults: VIVI_WORKTREE_CARRY carries repo.env into
# the next worktree, and VIVI_TEARDOWN_CMD is unset since nare starts no test stack.

# disclosure-guard: this repository is public. The private term list is never committed;
# CI reads it from a secret, agents from ~/.config/vivi/disclosure-terms.
VIVI_REPO_VISIBILITY=public
