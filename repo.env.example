# Copy to repo.env (gitignored). Read by the scripts in .agents/skills/*/scripts.
VIVI_REPO=ViviDynamics/nare
VIVI_DEFAULT_BRANCH=main
VIVI_MERGE_FLAGS="--squash --delete-branch"

# Workflow FILE name that gates PRs (e.g. ci.yml). Empty: all runs.
VIVI_CI_WORKFLOW=ci.yml

# Optional configuration for ship-issue and review workflows.
VIVI_REVIEW_TOOL=self   # self | copilot | harness
# VIVI_ASSIGNEE=
# VIVI_HOUSE_RULES_FILE=

# Test commands, flake signatures, and token file.
VIVI_TEST_COMMANDS_FILE=.agents/test-commands.md
# VIVI_FLAKE_SIGNATURES_FILE=.agents/flake-signatures.txt

# A file holding a GitHub token with access to this repo. When unset, the scripts
# use GH_TOKEN or GITHUB_TOKEN from the environment instead.
# VIVI_GH_TOKEN_FILE=$HOME/.config/nare/gh-token
