  "agent_script": "set -e\ngit init -q -b main\ngit add -A\ngit -c user.email=bench@nare.invalid -c user.name=nare-bench commit -qm fixture\nstatus=0\nclaude -p \"$BENCH_PROMPT\" \\\n     --model \"$BENCH_MODEL\" \\\n     --output-format stream-json --verbose \\\n     --permission-mode bypassPermissions \\\n     --max-turns \"$BENCH_MAX_TURNS\" \\\n     --disallowedTools=\"$BENCH_DISALLOWED\" \\\n     > /out/stream.jsonl 2> /out/stderr.txt || status=$?\npython3 -I -c \"$BENCH_LEFTOVERS\" /out/after.json || true\nexit \"$status\"\n",
  "cases": [
    "bash-timeout-recovery",
    "expense-tracker-cli",
    "long-test-output",
    "bootstrap-without-database"
  ],
  "reps": {
    "bash-timeout-recovery": 10,
    "bootstrap-without-database": 10,
    "expense-tracker-cli": 10,
    "long-test-output": 10
  },
  "excluded": {
    "ambiguous-after-reading": "a correct run asks, and the ask is recorded in nare's session file; headless Claude Code has no ask tool to record it with",
    "ambiguous-request": "a correct run ends blocked with a question, nare's stop status and session file, which headless Claude Code does not have",
    "impossible-test": "its honest outcomes are nare's blocked status or a closing message, read from nare's session file",
    "context-overflow": "measures nare's context elision, read from the session file's message history; Claude Code compacts by a different rule and exposes no such record",
    "context-overflow-small-window": "passes --context-window, a nare flag with no Claude Code counterpart",
    "mcp-fanout": "MCP is wired per harness (nare's mcp.json and server__tool names); not wired for Claude Code in this round",
    "mcp-large-result": "MCP is wired per harness (nare's mcp.json and server__tool names); not wired for Claude Code in this round",
    "typed-classify": "uses nare's --schema and typed output; Claude Code's --json-schema reports its result differently and is not wired here"
  },
